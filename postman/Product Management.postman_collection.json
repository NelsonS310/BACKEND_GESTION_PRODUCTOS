{
  "info": {
    "name": "Product Management",
    "description": "Ejecuta la colección en orden para probar el CRUD. La creación guarda el ID devuelto por la API en productId para las solicitudes siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "productId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Listar productos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK con una lista de productos', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear producto",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/products",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Monitor\",\n  \"price\": 179.90,\n  \"description\": \"24-inch monitor\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('productId', '');"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created con ID y cabecera Location', function () {",
              "  pm.response.to.have.status(201);",
              "  const product = pm.response.json();",
              "  pm.expect(product.id).to.be.a('number');",
              "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/products/' + product.id);",
              "  pm.collectionVariables.set('productId', String(product.id));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Consultar producto",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK con el producto creado', function () {",
              "  pm.response.to.have.status(200);",
              "  const product = pm.response.json();",
              "  pm.expect(String(product.id)).to.eql(pm.collectionVariables.get('productId'));",
              "  pm.expect(product.name).to.eql('Monitor');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Actualizar producto",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Monitor\",\n  \"price\": 159.90\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK con el precio actualizado', function () {",
              "  pm.response.to.have.status(200);",
              "  const product = pm.response.json();",
              "  pm.expect(String(product.id)).to.eql(pm.collectionVariables.get('productId'));",
              "  pm.expect(product.price).to.eql(159.90);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Eliminar producto",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', function () {",
              "  pm.response.to.have.status(204);",
              "  pm.expect(pm.response.text()).to.eql('');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Consultar producto eliminado",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found en formato ProblemDetail', function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  pm.expect(pm.response.json().status).to.eql(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
